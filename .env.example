# Required.
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: raises the GitHub API limit from 60/hr to 5000/hr.
# A classic token with no scopes is enough for public repos.
GITHUB_TOKEN=ghp_...

# Optional tuning.
# ARCHAEO_MODEL=claude-sonnet-5
# ARCHAEO_MAX_TURNS=40
# ARCHAEO_CACHE_DIR=~/.cache/repo-archaeologist

# Thinking. "auto" negotiates with the model: it tries adaptive thinking first
# (Claude 4.7 and later) and falls back to a manual token budget on older models.
# Set to adaptive / manual / off to pin one.
# ARCHAEO_THINKING=auto
# ARCHAEO_EFFORT=high              # low | medium | high — used in adaptive mode
# ARCHAEO_THINKING_BUDGET=3000     # only used in manual mode
